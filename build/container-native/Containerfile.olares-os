# Containerfile.olares-os
#
# Bootable container image for Olares OS
# Based on bootc (https://containers.github.io/bootc/)
#
# This creates an immutable OS image that runs k3s as a container (via Quadlet).
# Zero bootstrap binaries needed - k3s runs in a container, CNI plugins
# are installed by Calico DaemonSet. The system boots and auto-starts k3s.
#
# Build:
#   podman build --platform linux/amd64 \
#     -t ghcr.io/olares/os:latest \
#     -f Containerfile.olares-os .
#
# Generate ISO:
#   sudo podman run --rm --privileged \
#     -v $(pwd)/output:/output \
#     quay.io/centos-bootc/bootc-image-builder:latest \
#     --type iso \
#     ghcr.io/olares/os:latest
#
# Install to disk (from live environment):
#   bootc install to-disk --source-imgref ghcr.io/olares/os:latest /dev/sda

# =============================================================================
# Base Image: CentOS Stream 9 with bootc support
# Alternatives: quay.io/fedora/fedora-bootc:41, registry.opensuse.org/...
# =============================================================================
FROM quay.io/centos-bootc/centos-bootc:stream9

# Image metadata
LABEL org.opencontainers.image.title="Olares OS"
LABEL org.opencontainers.image.description="Immutable Kubernetes OS for personal cloud"
LABEL org.opencontainers.image.source="https://github.com/beclab/Olares"
LABEL org.opencontainers.image.vendor="Olares"
LABEL bootc.version="1.0"

# =============================================================================
# System Configuration
# =============================================================================

# Set timezone and locale
RUN ln -sf /usr/share/zoneinfo/UTC /etc/localtime

# Install essential packages (kept minimal for immutable OS)
RUN dnf install -y \
    # Networking tools
    iproute \
    iptables-nft \
    iputils \
    bind-utils \
    # System utilities
    procps-ng \
    util-linux \
    which \
    # Container tools - podman is our CRI backend
    podman \
    skopeo \
    # Filesystem
    e2fsprogs \
    xfsprogs \
    lvm2 \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# =============================================================================
# cri-dockerd: CRI adapter for podman
#
# cri-dockerd provides a CRI (Container Runtime Interface) socket that k3s
# kubelet connects to. cri-dockerd then talks to podman via Docker-compatible API.
#
# Flow: k3s kubelet → cri-dockerd → podman.socket → podman → containers
# =============================================================================

# Download and install cri-dockerd
ARG CRI_DOCKERD_VERSION=0.3.16
RUN curl -fsSL -o /tmp/cri-dockerd.tgz \
    "https://github.com/Mirantis/cri-dockerd/releases/download/v${CRI_DOCKERD_VERSION}/cri-dockerd-${CRI_DOCKERD_VERSION}.amd64.tgz" \
    && tar -xzf /tmp/cri-dockerd.tgz -C /tmp \
    && mv /tmp/cri-dockerd/cri-dockerd /usr/local/bin/ \
    && chmod +x /usr/local/bin/cri-dockerd \
    && rm -rf /tmp/cri-dockerd.tgz /tmp/cri-dockerd

# cri-dockerd systemd service - connects to podman socket
COPY <<'EOF' /usr/lib/systemd/system/cri-dockerd.service
[Unit]
Description=CRI Interface for Podman
Documentation=https://github.com/Mirantis/cri-dockerd
After=podman.socket
Requires=podman.socket

[Service]
Type=notify
ExecStart=/usr/local/bin/cri-dockerd --container-runtime-endpoint=unix:///run/podman/podman.sock --pod-infra-container-image=registry.k8s.io/pause:3.10
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

# cri-dockerd socket for kubelet
COPY <<'EOF' /usr/lib/systemd/system/cri-dockerd.socket
[Unit]
Description=CRI Docker Socket for the API
PartOf=cri-dockerd.service

[Socket]
ListenStream=/run/cri-dockerd.sock
SocketMode=0660
SocketUser=root
SocketGroup=root

[Install]
WantedBy=sockets.target
EOF

# Enable podman socket and cri-dockerd
RUN systemctl enable podman.socket \
    && systemctl enable cri-dockerd.service \
    && systemctl enable cri-dockerd.socket

# =============================================================================
# k3s: Lightweight Kubernetes
#
# k3s runs as a binary using podman as the container runtime via cri-dockerd:
#   k3s kubelet → cri-dockerd → podman.socket → podman containers
#
# This enables sharing container storage with the host (via virtiofs in VMs),
# since podman and the host use the same containers/storage format.
# =============================================================================

# Download k3s binary
ARG K3S_VERSION=v1.32.3+k3s1
RUN curl -fsSL -o /usr/local/bin/k3s \
    "https://github.com/k3s-io/k3s/releases/download/${K3S_VERSION}/k3s" \
    && chmod +x /usr/local/bin/k3s \
    && ln -sf /usr/local/bin/k3s /usr/local/bin/kubectl \
    && ln -sf /usr/local/bin/k3s /usr/local/bin/crictl \
    && ln -sf /usr/local/bin/k3s /usr/local/bin/ctr

# k3s systemd service - uses cri-dockerd as container runtime
COPY <<'EOF' /usr/lib/systemd/system/k3s.service
[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
After=cri-dockerd.service network-online.target
Wants=network-online.target
Requires=cri-dockerd.service

[Service]
Type=notify
EnvironmentFile=-/etc/default/k3s
EnvironmentFile=-/etc/sysconfig/k3s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s server \
    --container-runtime-endpoint=unix:///run/cri-dockerd.sock \
    --config=/etc/rancher/k3s/config.yaml
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

# Create directories that k3s/Calico will need
RUN mkdir -p /etc/rancher/k3s \
    && mkdir -p /opt/cni/bin \
    && mkdir -p /etc/cni/net.d \
    && mkdir -p /var/lib/kubelet \
    && mkdir -p /var/lib/rancher/k3s \
    && mkdir -p /var/log/pods

# Enable k3s
RUN systemctl enable k3s.service

# =============================================================================
# CNI Directories
#
# Calico runs as Kubernetes pods (DaemonSet). Its install-cni init container
# copies calico and calico-ipam binaries from calico/cni image to /opt/cni/bin.
# No CNI plugins need to be pre-installed - truly container-native!
# =============================================================================
# Directories already created above: /opt/cni/bin, /etc/cni/net.d

# =============================================================================
# CLI Wrapper Scripts
# kubectl, crictl, ctr are symlinks to k3s binary (created above)
# helm runs in a container
# =============================================================================

# helm wrapper - runs helm in a container with kubeconfig
COPY <<'EOF' /usr/local/bin/helm
#!/bin/bash
exec podman run --rm -i \
    -v /etc/rancher/k3s/k3s.yaml:/root/.kube/config:ro \
    --network=host \
    docker.io/alpine/helm:3.17.1 "$@"
EOF
RUN chmod +x /usr/local/bin/helm

# crictl config - point to cri-dockerd socket
COPY <<'EOF' /etc/crictl.yaml
runtime-endpoint: unix:///run/cri-dockerd.sock
image-endpoint: unix:///run/cri-dockerd.sock
timeout: 10
debug: false
EOF

# k3s configuration
COPY <<'EOF' /etc/rancher/k3s/config.yaml
# k3s server configuration for Olares
write-kubeconfig-mode: "0644"

# Disable k3s built-in components (Olares uses its own)
disable:
  - traefik       # Olares uses its own ingress
  - servicelb     # Olares uses its own load balancer

# Disable k3s embedded containerd (we use cri-dockerd → podman)
# The container-runtime-endpoint is set in systemd service
disable-agent: false

# Disable k3s built-in flannel (Olares uses Calico)
flannel-backend: none

# Additional API server SANs
tls-san:
  - "olares.local"
  - "localhost"

kubelet-arg:
  - "max-pods=250"
EOF

# =============================================================================
# Olares Agent
# =============================================================================

# Olares bootstrap agent (will be replaced with compiled binary)
COPY <<'AGENT_EOF' /usr/local/bin/olares-agent
#!/bin/bash
# Olares Bootstrap Agent
# This script runs after k3s starts and bootstraps the Olares system
#
# k3s runs as a binary using podman as container runtime via cri-dockerd

set -euo pipefail

OLARES_STATE_DIR="/var/lib/olares"
OLARES_CONFIG="/etc/olares/config.yaml"

log() {
    echo "[olares-agent] $(date -Iseconds) $*"
}

# kubectl is a symlink to k3s binary, runs directly
# helm wrapper - runs helm inside a container with kubeconfig access
helm() {
    podman run --rm \
        -v /etc/rancher/k3s/k3s.yaml:/root/.kube/config:ro \
        -v /var/lib/olares:/var/lib/olares \
        --network=host \
        docker.io/alpine/helm:3.17.1 "$@"
}

wait_for_k3s() {
    log "Waiting for k3s to be ready..."
    local retries=120
    local count=0
    
    # Wait for k3s service to be active
    while [[ $count -lt 30 ]]; do
        if systemctl is-active --quiet k3s; then
            break
        fi
        count=$((count + 1))
        sleep 2
    done
    
    # Then wait for the Kubernetes API to be ready
    count=0
    while [[ $count -lt $retries ]]; do
        if kubectl get nodes &>/dev/null; then
            log "k3s is ready"
            return 0
        fi
        count=$((count + 1))
        sleep 2
    done
    
    log "ERROR: Timeout waiting for k3s"
    return 1
}

is_bootstrapped() {
    [[ -f "${OLARES_STATE_DIR}/bootstrapped" ]]
}

bootstrap() {
    log "Starting Olares bootstrap..."
    
    mkdir -p "$OLARES_STATE_DIR"
    
    # Create olares-system namespace
    kubectl create namespace olares-system --dry-run=client -o yaml | \
        kubectl apply -f -
    
    # Apply system configuration
    # TODO: Install Helm charts from OCI registry
    # helm upgrade --install olares-system oci://ghcr.io/olares/charts/system
    
    # Mark as bootstrapped
    date -Iseconds > "${OLARES_STATE_DIR}/bootstrapped"
    log "Bootstrap complete"
}

main() {
    case "${1:-bootstrap}" in
        bootstrap)
            wait_for_k3s
            if is_bootstrapped; then
                log "System already bootstrapped, skipping"
            else
                bootstrap
            fi
            ;;
        status)
            if is_bootstrapped; then
                echo "Bootstrapped: $(cat "${OLARES_STATE_DIR}/bootstrapped")"
            else
                echo "Not bootstrapped"
            fi
            ;;
        *)
            echo "Usage: olares-agent {bootstrap|status}"
            exit 1
            ;;
    esac
}

main "$@"
AGENT_EOF

RUN chmod +x /usr/local/bin/olares-agent

# Olares agent systemd service
COPY <<'EOF' /usr/lib/systemd/system/olares-agent.service
[Unit]
Description=Olares Bootstrap Agent
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/olares-agent bootstrap
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

# =============================================================================
# Olares Configuration
# =============================================================================

# Default configuration
RUN mkdir -p /etc/olares
COPY <<'EOF' /etc/olares/config.yaml
# Olares OS Configuration
version: "1.0"

# Cluster settings
cluster:
  name: olares
  domain: olares.local

# Storage settings
storage:
  data_dir: /var/lib/olares
  
# Network settings
network:
  # Set to your actual domain for production
  external_domain: ""
EOF

# =============================================================================
# Enable Services
# =============================================================================

# Note: k3s.service is auto-generated by Quadlet from k3s.container
# We just need to enable olares-agent which depends on it
RUN systemctl enable olares-agent.service

# =============================================================================
# Persistent Data Directories
# These will be mounted from the host's persistent storage
# =============================================================================

# k3s data (etcd, containerd images, etc.)
VOLUME /var/lib/rancher/k3s

# Olares application data
VOLUME /var/lib/olares

# User home directories
VOLUME /home

# =============================================================================
# Boot Configuration
# =============================================================================

# Default kernel arguments for bootc
COPY <<'EOF' /usr/lib/bootc/kargs.d/olares.toml
kargs = [
    "systemd.unified_cgroup_hierarchy=1",
    "cgroup_enable=cpuset",
    "cgroup_enable=memory",
    "cgroup_memory=1"
]
EOF

# =============================================================================
# Final Setup
# =============================================================================

# Clean up
RUN dnf clean all && rm -rf /var/cache/dnf /tmp/*

# Set default target
RUN systemctl set-default multi-user.target
