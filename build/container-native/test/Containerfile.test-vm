# Containerfile.test-vm
#
# Container that runs an Olares VM for testing.
# The VM automatically updates itself from the configured registry on every boot.
#
# Requirements:
#   - KVM support on host (/dev/kvm must exist)
#   - Disk image mounted at /vm/disk.qcow2 (or will be created)
#
# Usage:
#   # Build test container
#   podman build -t olares-test-vm -f Containerfile.test-vm .
#
#   # Run with existing disk
#   podman run --rm -it --privileged \
#     --device /dev/kvm \
#     -v ./vm-data:/vm \
#     -e OLARES_REGISTRY=ghcr.io/myuser \
#     -e OLARES_TAG=pr-123 \
#     olares-test-vm
#
#   # Share host podman storage to avoid re-downloading images:
#   podman run --rm -it --privileged \
#     --device /dev/kvm \
#     -v ./vm-data:/vm \
#     -v ~/.local/share/containers/storage:/var/lib/containers/storage:O \
#     -e OLARES_REGISTRY=ghcr.io/myuser \
#     -e OLARES_TAG=pr-123 \
#     olares-test-vm
#
#   # The VM will boot, update to PR images, reboot into Olares

FROM fedora:41

LABEL org.opencontainers.image.title="Olares Test VM Runner"
LABEL org.opencontainers.image.description="Runs Olares in a VM with auto-update on boot"

# Install QEMU, virtiofsd, networking tools
RUN dnf install -y \
    qemu-system-x86 \
    qemu-img \
    virtiofsd \
    cloud-utils-growpart \
    podman \
    skopeo \
    curl \
    jq \
    # For TAP networking
    iproute \
    iptables-nft \
    dnsmasq \
    # For cloud-init ISO
    genisoimage \
    && dnf clean all

# =============================================================================
# Configuration
# =============================================================================

# Default registry and tag (override via environment)
ENV OLARES_REGISTRY=ghcr.io/olares
ENV OLARES_TAG=latest
ENV OLARES_IMAGE=os

# VM configuration
ENV VM_MEMORY=4096
ENV VM_CPUS=2
ENV VM_DISK_SIZE=50G
ENV VM_SSH_PORT=2222
ENV VM_VNC_PORT=5900

# Disk path (must be mounted from host for persistence)
ENV VM_DISK=/vm/disk.qcow2

# Share container storage with guest via virtiofs
# When enabled, host podman storage is shared with the VM
# Requires: -v ~/.local/share/containers/storage:/var/lib/containers/storage:O
ENV VM_SHARE_STORAGE=true

# Network mode: "user" (port forwarding) or "tap" (bridged, VM gets own IP)
ENV VM_NETWORK_MODE=tap

# Cloud image URL for initial disk (cached in /vm/cloud-base.qcow2)
ENV VM_CLOUD_IMAGE_URL=https://download.fedoraproject.org/pub/fedora/linux/releases/41/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-41-1.4.x86_64.qcow2
# For TAP mode: VM network configuration
ENV VM_BRIDGE_IP=192.168.100.1
ENV VM_BRIDGE_SUBNET=192.168.100.0/24
ENV VM_DHCP_START=192.168.100.10
ENV VM_DHCP_END=192.168.100.50
# VM hostname (used by DHCP/DNS)
ENV VM_HOSTNAME=olares-test

# =============================================================================
# Scripts
# =============================================================================

# Main entrypoint script
COPY <<'ENTRYPOINT' /usr/local/bin/start-vm
#!/bin/bash
set -euo pipefail

VM_DISK="${VM_DISK:-/vm/disk.qcow2}"
VM_MEMORY="${VM_MEMORY:-4096}"
VM_CPUS="${VM_CPUS:-2}"
VM_DISK_SIZE="${VM_DISK_SIZE:-50G}"
VM_SSH_PORT="${VM_SSH_PORT:-2222}"
VM_VNC_PORT="${VM_VNC_PORT:-5900}"

# Network configuration
VM_NETWORK_MODE="${VM_NETWORK_MODE:-tap}"
VM_BRIDGE_IP="${VM_BRIDGE_IP:-192.168.100.1}"
VM_BRIDGE_SUBNET="${VM_BRIDGE_SUBNET:-192.168.100.0/24}"
VM_DHCP_START="${VM_DHCP_START:-192.168.100.10}"
VM_DHCP_END="${VM_DHCP_END:-192.168.100.50}"
VM_HOSTNAME="${VM_HOSTNAME:-olares-test}"

OLARES_REGISTRY="${OLARES_REGISTRY:-ghcr.io/olares}"
OLARES_TAG="${OLARES_TAG:-latest}"
OLARES_IMAGE="${OLARES_IMAGE:-os}"

FULL_IMAGE="${OLARES_REGISTRY}/olares-${OLARES_IMAGE}:${OLARES_TAG}"

# Will be set by setup_network
VM_IP=""

log() {
    echo "[test-vm] $(date -Iseconds) $*"
}

# Check KVM support
check_kvm() {
    if [[ ! -e /dev/kvm ]]; then
        log "ERROR: /dev/kvm not found. Run with --device /dev/kvm"
        log "If running on Linux, ensure KVM is available:"
        log "  - Intel: modprobe kvm_intel"
        log "  - AMD: modprobe kvm_amd"
        exit 1
    fi
    log "KVM support: OK"
}

# Setup TAP networking with bridge and DHCP
setup_network() {
    if [[ "$VM_NETWORK_MODE" != "tap" ]]; then
        log "Network mode: user (port forwarding)"
        return 0
    fi
    
    log "Setting up TAP networking..."
    
    # Create bridge
    if ! ip link show br0 &>/dev/null; then
        ip link add br0 type bridge
        ip addr add "${VM_BRIDGE_IP}/24" dev br0
        ip link set br0 up
        log "Created bridge br0 with IP ${VM_BRIDGE_IP}"
    fi
    
    # Create TAP device for VM
    if ! ip link show tap0 &>/dev/null; then
        ip tuntap add tap0 mode tap
        ip link set tap0 master br0
        ip link set tap0 up
        log "Created TAP device tap0"
    fi
    
    # Enable IP forwarding
    echo 1 > /proc/sys/net/ipv4/ip_forward
    
    # Setup NAT for outbound traffic
    iptables -t nat -A POSTROUTING -s "${VM_BRIDGE_SUBNET}" ! -d "${VM_BRIDGE_SUBNET}" -j MASQUERADE
    iptables -A FORWARD -i br0 -j ACCEPT
    iptables -A FORWARD -o br0 -m state --state RELATED,ESTABLISHED -j ACCEPT
    
    # Start dnsmasq for DHCP and DNS
    # Use fixed MAC address 52:54:00:12:34:56 (same as QEMU VM)
    mkdir -p /var/run/dnsmasq
    cat > /var/run/dnsmasq/dnsmasq.conf << EOF
interface=br0
bind-interfaces
dhcp-range=${VM_DHCP_START},${VM_DHCP_END},12h
dhcp-option=option:router,${VM_BRIDGE_IP}
dhcp-option=option:dns-server,${VM_BRIDGE_IP}
dhcp-host=52:54:00:12:34:56,${VM_HOSTNAME},${VM_DHCP_START}
address=/${VM_HOSTNAME}/${VM_DHCP_START}
log-queries
log-dhcp
EOF
    
    dnsmasq -C /var/run/dnsmasq/dnsmasq.conf --pid-file=/var/run/dnsmasq/dnsmasq.pid
    log "Started dnsmasq (DHCP: ${VM_DHCP_START}-${VM_DHCP_END})"
    
    # Set expected VM IP
    VM_IP="${VM_DHCP_START}"
    
    log "Network mode: tap (VM will get IP ${VM_IP})"
    log "  VM hostname: ${VM_HOSTNAME}"
    log "  Access: ssh root@${VM_HOSTNAME} or ssh root@${VM_IP}"
}

# Create or verify disk image
setup_disk() {
    local disk_dir=$(dirname "$VM_DISK")
    
    if [[ ! -d "$disk_dir" ]]; then
        log "ERROR: Disk directory not mounted: $disk_dir"
        log "Run with: -v /path/to/vm-data:/vm"
        exit 1
    fi
    
    if [[ ! -f "$VM_DISK" ]]; then
        log "Creating new disk image: $VM_DISK ($VM_DISK_SIZE)"
        log "This will be a fresh Olares installation."
        
        # Need to build initial image from netinstall
        create_initial_disk
    else
        log "Using existing disk: $VM_DISK"
        log "VM will update to ${FULL_IMAGE} on boot."
    fi
}

# Create initial disk from a cloud image
# This uses a generic Fedora/CentOS cloud image and cloud-init to bootc switch
create_initial_disk() {
    local cloud_image_url="${VM_CLOUD_IMAGE_URL:-https://download.fedoraproject.org/pub/fedora/linux/releases/41/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-41-1.4.x86_64.qcow2}"
    local cloud_image="/vm/cloud-base.qcow2"
    
    log "Creating initial disk from cloud image..."
    
    # Download cloud image if not cached
    if [[ ! -f "$cloud_image" ]]; then
        log "Downloading cloud image..."
        log "URL: ${cloud_image_url}"
        curl -fSL -o "$cloud_image" "$cloud_image_url" || {
            log "ERROR: Failed to download cloud image"
            exit 1
        }
        log "Cloud image downloaded: $(du -h "$cloud_image" | cut -f1)"
    else
        log "Using cached cloud image: $cloud_image"
    fi
    
    # Create disk from cloud image
    log "Creating VM disk from cloud image..."
    cp "$cloud_image" "$VM_DISK"
    
    # Resize disk to target size
    log "Resizing disk to ${VM_DISK_SIZE}..."
    qemu-img resize "$VM_DISK" "$VM_DISK_SIZE"
    
    log "Initial disk created: $VM_DISK"
    log ""
    log "On first boot, cloud-init will:"
    log "  1. Install bootc"
    log "  2. Switch to ${FULL_IMAGE}"
    log "  3. Reboot into Olares"
}

# Write cloud-init config for bootstrapping and auto-update
setup_cloud_init() {
    local ci_dir="/vm/cidata"
    mkdir -p "$ci_dir"
    
    # Marker file to track if we've done initial switch
    local switch_marker="/var/lib/olares-switched"
    
    # Create user-data that handles both initial switch and updates
    cat > "${ci_dir}/user-data" << EOF
#cloud-config
# Olares Test VM Cloud-Init Configuration
# Handles: initial bootc switch OR subsequent updates

# Set password for root (for debugging)
chpasswd:
  list: |
    root:olares
  expire: false

ssh_pwauth: true

# Enable root SSH login
runcmd:
  - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
  - systemctl restart sshd
  - |
    set -x
    SWITCH_MARKER="${switch_marker}"
    TARGET_IMAGE="${FULL_IMAGE}"
    
    echo "=== Olares Test VM Bootstrap ===" | tee -a /var/log/olares-bootstrap.log
    date | tee -a /var/log/olares-bootstrap.log
    
    if command -v bootc &>/dev/null; then
      echo "bootc is available" | tee -a /var/log/olares-bootstrap.log
      
      if [[ -f "\$SWITCH_MARKER" ]]; then
        # Already switched - just check for updates
        echo "Checking for updates to \$TARGET_IMAGE..." | tee -a /var/log/olares-bootstrap.log
        if bootc upgrade 2>&1 | tee -a /var/log/olares-bootstrap.log; then
          if bootc status | grep -q "staged"; then
            echo "Update staged, rebooting..." | tee -a /var/log/olares-bootstrap.log
            touch /run/reboot-required
          fi
        fi
      else
        # First boot - do the switch
        echo "First boot: switching to \$TARGET_IMAGE..." | tee -a /var/log/olares-bootstrap.log
        if bootc switch --retain "\$TARGET_IMAGE" 2>&1 | tee -a /var/log/olares-bootstrap.log; then
          touch "\$SWITCH_MARKER"
          echo "Switch successful, rebooting..." | tee -a /var/log/olares-bootstrap.log
          touch /run/reboot-required
        else
          echo "ERROR: bootc switch failed" | tee -a /var/log/olares-bootstrap.log
        fi
      fi
    else
      # No bootc yet - install it (Fedora cloud image)
      echo "Installing bootc..." | tee -a /var/log/olares-bootstrap.log
      dnf install -y bootc 2>&1 | tee -a /var/log/olares-bootstrap.log || true
      
      if command -v bootc &>/dev/null; then
        echo "bootc installed, switching to \$TARGET_IMAGE..." | tee -a /var/log/olares-bootstrap.log
        if bootc switch --retain "\$TARGET_IMAGE" 2>&1 | tee -a /var/log/olares-bootstrap.log; then
          touch "\$SWITCH_MARKER"
          echo "Switch successful, rebooting..." | tee -a /var/log/olares-bootstrap.log
          touch /run/reboot-required
        else
          echo "ERROR: bootc switch failed" | tee -a /var/log/olares-bootstrap.log
        fi
      else
        echo "ERROR: Failed to install bootc" | tee -a /var/log/olares-bootstrap.log
      fi
    fi

# Reboot if needed
power_state:
  delay: "+1"
  mode: reboot
  condition: test -f /run/reboot-required
EOF

    # Create meta-data
    cat > "${ci_dir}/meta-data" << EOF
instance-id: ${VM_HOSTNAME}
local-hostname: ${VM_HOSTNAME}
EOF

    # Create cloud-init ISO
    log "Creating cloud-init ISO..."
    if command -v genisoimage &>/dev/null; then
        genisoimage -output /vm/cidata.iso -volid cidata -joliet -rock \
            "${ci_dir}/user-data" "${ci_dir}/meta-data" 2>/dev/null
    elif command -v mkisofs &>/dev/null; then
        mkisofs -output /vm/cidata.iso -volid cidata -joliet -rock \
            "${ci_dir}/user-data" "${ci_dir}/meta-data" 2>/dev/null
    else
        log "WARN: No ISO creation tool found, cloud-init disabled"
        return
    fi
    
    log "Cloud-init configured:"
    log "  - Root password: olares"
    log "  - First boot: install bootc, switch to ${FULL_IMAGE}"
    log "  - Subsequent boots: check for updates"
}

# Start QEMU
start_qemu() {
    log "Starting QEMU VM..."
    log "  Memory: ${VM_MEMORY}M"
    log "  CPUs: ${VM_CPUS}"
    log "  Disk: ${VM_DISK}"
    log ""
    log "Target image: ${FULL_IMAGE}"
    log ""

    local qemu_args=(
        -name "olares-test"
        -machine q35,accel=kvm
        -cpu host
        -m "${VM_MEMORY}"
        -smp "${VM_CPUS}"
        -drive "file=${VM_DISK},format=qcow2,if=virtio"
        -vnc ":$(( VM_VNC_PORT - 5900 ))"
        -serial stdio
        -monitor none
    )
    
    # Network configuration based on mode
    if [[ "$VM_NETWORK_MODE" == "tap" ]]; then
        qemu_args+=(
            -netdev "tap,id=net0,ifname=tap0,script=no,downscript=no"
            -device "virtio-net-pci,netdev=net0,mac=52:54:00:12:34:56"
        )
        log "Network: TAP (VM IP: ${VM_IP}, hostname: ${VM_HOSTNAME})"
        log "Connect via SSH: ssh root@${VM_HOSTNAME}  (or ssh root@${VM_IP})"
    else
        qemu_args+=(
            -netdev "user,id=net0,hostfwd=tcp::${VM_SSH_PORT}-:22,hostfwd=tcp::6443-:6443,hostfwd=tcp::8080-:80,hostfwd=tcp::8443-:443"
            -device "virtio-net-pci,netdev=net0"
        )
        log "Network: User mode (port forwarding)"
        log "Connect via SSH: ssh -p ${VM_SSH_PORT} root@localhost"
    fi
    log "Connect via VNC: vncviewer localhost:${VM_VNC_PORT}"
    log ""
    
    # Add cloud-init if available
    if [[ -f /vm/cidata.iso ]]; then
        qemu_args+=(-cdrom /vm/cidata.iso)
    fi
    
    # Enable UEFI boot
    if [[ -f /usr/share/edk2/ovmf/OVMF_CODE.fd ]]; then
        qemu_args+=(
            -drive "if=pflash,format=raw,readonly=on,file=/usr/share/edk2/ovmf/OVMF_CODE.fd"
        )
    fi
    
    exec qemu-system-x86_64 "${qemu_args[@]}"
}

main() {
    log "============================================"
    log "Olares Test VM Runner"
    log "============================================"
    log ""
    
    check_kvm
    setup_network
    setup_disk
    setup_cloud_init
    start_qemu
}

main "$@"
ENTRYPOINT

RUN chmod +x /usr/local/bin/start-vm

# Volume for VM disk (must be mounted)
VOLUME /vm

# Expose ports
EXPOSE 2222 5900 6443 8080 8443

# Default command
ENTRYPOINT ["/usr/local/bin/start-vm"]
